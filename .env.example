# Токен бота от @BotFather. Без него запустится только веб-часть.
BOT_TOKEN=123456:AA...

# Публичный HTTPS-адрес Mini App. Telegram не откроет http:// и localhost.
# Пример: https://crypta.example.com  или временно `cloudflared tunnel --url http://localhost:8000`
WEBAPP_URL=

# Где лежит база. В докере удобно /data/crypta.db
DB_PATH=crypta.db

HOST=0.0.0.0
PORT=8000

# 1 — разрешает открывать Mini App в браузере без Telegram (заголовок X-Dev-Id).
# В продакшене держать 0: иначе авторизация фактически отключена.
DEV_MODE=0
